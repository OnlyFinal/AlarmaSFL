<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🌻 ALARMASFL"
            android:textColor="#294B32"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sin datos"
            android:textColor="#71806B"
            android:textSize="10sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/market"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Plaza (P2P)"
        android:textColor="#71806B"
        android:textSize="10sp"
        android:paddingTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/pepper_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PEPPER"
                android:textColor="#B84E3C"
                android:textStyle="bold"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/pepper_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#263B2D"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/pepper_chart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:scaleType="fitXY"
                android:contentDescription="Indicador del primer cultivo"/>

            <TextView
                android:id="@+id/pepper_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin alertas"
                android:textColor="#71806B"
                android:textSize="9sp"
                android:maxLines="2"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/blueberry_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BLUEBERRY"
                android:textColor="#536C9C"
                android:textStyle="bold"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/blueberry_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#263B2D"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/blueberry_chart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:scaleType="fitXY"
                android:contentDescription="Indicador del segundo cultivo"/>

            <TextView
                android:id="@+id/blueberry_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin alertas"
                android:textColor="#71806B"
                android:textSize="9sp"
                android:maxLines="2"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#9B493B"
        android:textSize="9sp"
        android:maxLines="2"/>
</LinearLayout>
